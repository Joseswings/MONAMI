# Demo desplegada de pitch. Copiar a .env.local SOLO al configurar la conexión real.
DEMO_MODE=false
PITCH_MODE=true
PITCH_SCENARIO_ID=monami-pitch
# Acceso: elegir una clave fácil de compartir de 8 a 64 caracteres.
# Reinicio: generar otra clave privada de 24 a 256 caracteres. Deben ser distintas.
# No poner claves reales en React ni Git; los valores siguientes se deben reemplazar.
PITCH_ACCESS_KEY=REPLACE_WITH_MEMORABLE_ACCESS_KEY
PITCH_RESET_KEY=REPLACE_WITH_RANDOM_PRESENTER_KEY
# URL tomada de Supabase Connect; codificar caracteres reservados de la contraseña.
DATABASE_URL=postgresql+psycopg://APP_USER:REPLACE_ME@DB_HOST:5432/postgres?sslmode=require
# Opcional: conexión con permisos DDL, usada SOLO por Alembic.
# MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:REPLACE_ME@DB_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=["http://localhost:5173"]
SESSION_TTL_MINUTES=480
# Carga del escenario: python -m app.pitch_seed, después de alembic upgrade head.
# Referencia de identidad del hito 1 (PITCH_MODE=false), ajena al acceso compartido de pitch.
# DEMO_CLIENT_PASSWORD=
# DEMO_COMPANY_PASSWORD=
# DEMO_DRIVER_PASSWORD=
# PostgreSQL de pruebas separado; nunca usar la base de la demo.
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:REPLACE_ME@TEST_HOST:5432/monami_test?sslmode=require
# MONAMI_TEST_DATABASE_CONFIRMED=true
